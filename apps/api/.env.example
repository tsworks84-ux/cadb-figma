# CADB API — environment template. Copy to apps/api/.env for local development.
# On the servers these come from ~/CADB/apps/api/.env (production) or the PM2 ecosystem file (staging).
# Never commit real values.
#
# Variables shown commented out have a default in the code. Leave them commented unless you need a
# different value: defaults apply only when a variable is UNSET, so an empty string overrides them
# (an empty RESOURCE_MAX_UPLOAD_MB, for example, makes the upload limit 0 bytes).

# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cadb"
# Signs access (15 min) and refresh (7 day) tokens for staff and students. Long random string.
JWT_SECRET="change-me-to-a-long-random-string"
NODE_ENV="development"
# API_PORT=4000

# Web origin — added to the CORS allow-list and used for links in emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email notifications (optional; without SMTP_HOST, email is skipped silently) ──
# Careful: with real values, local testing sends real email to real people.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CADB <no-reply@example.com>"

# ── File storage (optional) ───────────────────────────────────────────────────
# Leave AWS_S3_BUCKET empty to store uploads on local disk (apps/api/uploads/), which is what
# staging and production do. If set without AWS credentials, every upload fails.
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""

# ── Resources library: Google Shared Drive via a service account (optional) ──
GOOGLE_DRIVE_SHARED_DRIVE_ID=""
# Either a path to the service-account JSON key…
GOOGLE_DRIVE_KEY_FILE=""
# …or the key itself (raw JSON or base64).
GOOGLE_DRIVE_KEY_JSON=""
# RESOURCE_MAX_UPLOAD_MB=1024

# ── Google Calendar connection (optional) ─────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/calendar/callback"

# ── WhatsApp Cloud API (optional; not live — needs a WhatsApp Business account) ──
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TOKEN=""
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_LANG=en
DEFAULT_COUNTRY_CODE="91"
# Approved message-template names, one per event (see apps/api/src/utils/notify/templates.ts):
WHATSAPP_TEMPLATE_LEAVE_APPLIED=""
WHATSAPP_TEMPLATE_LEAVE_CANCEL=""
WHATSAPP_TEMPLATE_LEAVE_APPROVED=""
WHATSAPP_TEMPLATE_LEAVE_REJECTED=""
WHATSAPP_TEMPLATE_CLAIM_SUBMITTED=""
WHATSAPP_TEMPLATE_CLAIM_CANCEL=""
WHATSAPP_TEMPLATE_CLAIM_APPROVED=""
WHATSAPP_TEMPLATE_CLAIM_REJECTED=""
WHATSAPP_TEMPLATE_CLAIM_PAID=""
