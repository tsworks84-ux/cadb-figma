# CADB web — environment template. Copy to apps/web/.env.local for local development.
#
# NEXT_PUBLIC_* values are compiled into the JavaScript bundle at BUILD time.
# Build for each environment with the right value on the command line, e.g.
#   NEXT_PUBLIC_API_URL=https://cadb.centumacademy.com pnpm --filter=@cadb/web build   (production)
#   NEXT_PUBLIC_API_URL=http://65.0.41.55:4001          pnpm --filter=@cadb/web build   (staging)

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
