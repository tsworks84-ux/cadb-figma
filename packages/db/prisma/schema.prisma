generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
  INTERN
}

enum EmploymentStatus {
  DRAFT
  ACTIVE
  ON_LEAVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
  RETIRED
  EXITED
}

enum DegreeLevel {
  SCHOOL
  UG
  PG
  PHD
  DIPLOMA
  CERTIFICATION
  OTHER
}

enum DocumentType {
  PASSPORT_PHOTO
  PAN_CARD
  AADHAAR_CARD
  ADDRESS_PROOF
  CERTIFICATE
  DEGREE_CERTIFICATE
  EXPERIENCE_LETTER
  UG_DEGREE
  PG_DEGREE
  DOCTORATE_DEGREE
  BED_DEGREE
  OTHER
}

enum LeaveType {
  CASUAL
  SICK
  EARNED
  MATERNITY
  PATERNITY
  COMPENSATORY
  UNPAID
  SPECIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  // Employee asked to withdraw an already-approved leave; awaiting the approver's sign-off.
  CANCELLATION_PENDING
}


enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
  // Employee asked to withdraw an already-approved claim; awaiting the approver's sign-off.
  CANCELLATION_PENDING
}

enum TrainingStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BonusPlanFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum BonusPlanStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum BonusPayoutStatus {
  SCHEDULED
  PAID
  CANCELLED
}

enum PolicyCategory {
  HR
  FINANCE
  IT
  OPERATIONS
  COMPLIANCE
  ACADEMIC
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AnnouncementType {
  GENERAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_EMPLOYEES
  MANAGERS
  HR_ONLY
  STUDENTS
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  GRADUATED
  DROPPED
}

enum ScheduleStatus {
  UPCOMING
  COMPLETED
  CONCLUDED
  CANCELLED
}

enum ClassMode {
  ONLINE
  OFFLINE
}

enum AssignmentStatus {
  DUE
  COMPLETED
  ARCHIVED
}

enum ExamStatus {
  DUE
  COMPLETED
  MARKED
  CANCELLED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  IN_PROCESS
  APPROVED
  REJECTED
}

enum ReminderType {
  NONE
  ON_DUE_DATE
  THIRTY_MIN_BEFORE
  ONE_HOUR_BEFORE
  THREE_HOURS_BEFORE
  ONE_DAY_BEFORE
  TWO_DAYS_BEFORE
  ONE_WEEK_BEFORE
  CUSTOM
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
}

enum SalaryComponent {
  BASIC
  HRA
  CONVEYANCE
  MEDICAL
  SPECIAL_ALLOWANCE
  PF_EMPLOYER
  ESI_EMPLOYER
  GRATUITY
  BONUS
  INCENTIVE
  TDS
  PF_EMPLOYEE
  ESI_EMPLOYEE
  PROFESSIONAL_TAX
  ADVANCE_DEDUCTION
}

// ─── DEPARTMENTS & DESIGNATIONS ─────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  headId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees       Employee[]
  head            Employee?              @relation("DeptHead", fields: [headId], references: [id])
  memberships     EmployeeDepartment[]
  roleAccess      RoleDepartmentAccess[]

  @@index([code])
}

// ─── CUSTOM ROLES ─────────────────────────────────────────────────────────────

model CustomRole {
  name      String   @id
  label     String
  createdAt DateTime @default(now())

  deptAccess RoleDepartmentAccess[]
}

model RoleDepartmentAccess {
  id           String @id @default(cuid())
  roleName     String
  departmentId String

  role       CustomRole @relation(fields: [roleName],     references: [name],       onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id],         onDelete: Cascade)

  @@unique([roleName, departmentId])
  @@index([roleName])
  @@index([departmentId])
}

model Designation {
  id        String   @id @default(cuid())
  title     String   @unique
  grade     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

// ─── EMPLOYEE CORE ───────────────────────────────────────────────────────────

model Employee {
  id              String           @id @default(cuid())
  employeeCode    String           @unique
  email           String           @unique
  passwordHash    String

  // Personal Details
  firstName       String
  lastName        String
  middleName      String?
  gender          Gender?
  dateOfBirth     DateTime?
  maritalStatus   MaritalStatus?
  bloodGroup      BloodGroup?
  nationality     String           @default("Indian")
  religion        String?
  photoUrl        String?

  // Contact
  personalPhone   String?
  officialPhone   String?
  personalEmail   String?

  // Address
  currentAddress  Json?
  permanentAddress Json?

  // Emergency Contact
  emergencyContactName  String?
  emergencyContactPhone String?
  emergencyRelation     String?

  // Identity Documents
  aadhaarEncrypted  String?
  panEncrypted      String?
  uanNumber         String?
  passportNumber    String?
  passportExpiry    DateTime?

  // Employment
  departmentId    String
  designationId   String
  reportingToId   String?
  employmentType  EmploymentType   @default(FULL_TIME)
  status          EmploymentStatus @default(PROBATION)
  joiningDate     DateTime
  confirmationDate DateTime?
  terminationDate DateTime?
  terminationReason String?

  // Work location
  workLocation    String?

  // Role (stored in DB; no longer derived from employee code prefix)
  role            String   @default("EMPLOYEE")

  // Auth flags
  mustChangePassword Boolean  @default(true)

  // Soft delete
  deletedAt       DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  department        Department          @relation(fields: [departmentId], references: [id])
  designation       Designation         @relation(fields: [designationId], references: [id])
  reportingTo       Employee?           @relation("ReportingTo", fields: [reportingToId], references: [id])
  directReports     Employee[]          @relation("ReportingTo")
  headOfDept        Department[]        @relation("DeptHead")

  qualifications    Qualification[]
  certifications    Certification[]
  documents         EmployeeDocument[]
  salaryStructure   SalaryStructure?
  salaryConfig      EmployeeSalaryConfig?
  salarySlips       SalarySlip[]
  bankDetails       BankDetail[]
  leaveBalances     LeaveBalance[]
  leaveApplications LeaveApplication[]
  partTimeEntries   PartTimeEntry[]
  claimsSubmitted   ReimbursementClaim[]
  claimsApproved    ReimbursementClaim[] @relation("ClaimApprover")
  policyAcks        PolicyAcknowledgement[]
  trainingEnrollments TrainingEnrollment[]
  leavesApproved    LeaveApplication[]   @relation("LeaveApprover")
  leaveCancelsDecided LeaveApplication[] @relation("LeaveCancelApprover")
  claimCancelsDecided ReimbursementClaim[] @relation("ClaimCancelApprover")
  auditLogs         AuditLog[]
  bonusPlansReceived BonusPlan[]         @relation("BonusReceiver")
  bonusPlansGiven   BonusPlan[]         @relation("BonusAppraiser")
  bonusPayouts      BonusPayout[]
  teamOwned         TeamMembership[]    @relation("TeamOwner")
  teamOf            TeamMembership[]    @relation("TeamMember")
  tasksAssigned     Task[]              @relation("TaskAssigner")
  tasksReceived     Task[]              @relation("TaskAssignee")
  taskComments      TaskComment[]       @relation("TaskCommentAuthor")
  personalTodos     PersonalTodo[]
  googleCalendar    GoogleCalendarConnection?
  announcements        Announcement[]           @relation("AnnouncementAuthor")
  announcementViews    AnnouncementView[]       @relation("AnnouncementViewer")
  announcementAcks     AnnouncementAck[]        @relation("AnnouncementAcker")
  deptMemberships   EmployeeDepartment[]     @relation("EmpDeptMemberships")
  deptMembershipsAdded EmployeeDepartment[]  @relation("DeptMembershipAddedBy")
  directoryEntry       DirectoryEntry?
  facultySubjects      BatchSubject[]      @relation("FacultySubjects")
  schedulesTaught      Schedule[]          @relation("FacultySchedules")
  assignmentsTaught    Assignment[]        @relation("FacultyAssignments")
  mentorBatches        Batch[]             @relation("BatchFacultyMentor")
  ptmsCreated          PTM[]               @relation("PTMCreatedBy")
  ptmAttendances       PTMAttendee[]

  @@index([departmentId])
  @@index([designationId])
  @@index([reportingToId])
  @@index([status])
  @@index([employmentType])
  @@index([deletedAt])
  @@index([employeeCode])
}

// ─── EMPLOYEE ↔ DEPARTMENT (many-to-many) ────────────────────────────────────

model EmployeeDepartment {
  id           String     @id @default(cuid())
  employeeId   String
  departmentId String
  isHead       Boolean    @default(false)
  addedById    String
  addedAt      DateTime   @default(now())

  employee   Employee   @relation("EmpDeptMemberships",    fields: [employeeId],   references: [id], onDelete: Cascade)
  department Department @relation(                         fields: [departmentId], references: [id], onDelete: Cascade)
  addedBy    Employee   @relation("DeptMembershipAddedBy", fields: [addedById],    references: [id])

  @@unique([employeeId, departmentId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([isHead])
}

// ─── WORK LOCATIONS ──────────────────────────────────────────────────────────

model WorkLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// ─── PROFESSIONAL DETAILS ────────────────────────────────────────────────────

model Qualification {
  id           String      @id @default(cuid())
  employeeId   String
  level        DegreeLevel
  degreeName   String
  specialization String?
  institution  String
  boardUniversity String
  yearOfPassing Int
  percentage   Float?
  cgpa         Float?
  documentUrl  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([level])
}

// ─── CERTIFICATIONS ──────────────────────────────────────────────────────────

model Certification {
  id            String    @id @default(cuid())
  employeeId    String
  name          String
  issuingBody   String
  credentialId  String?
  issueDate     DateTime
  expiryDate    DateTime?
  documentUrl   String?
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([expiryDate])
}

// ─── SALARY & BENEFITS ───────────────────────────────────────────────────────

model SalaryStructure {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  ctc           Float
  effectiveFrom DateTime
  effectiveTo   DateTime?
  components    SalaryComponent[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items         SalaryStructureItem[]

  @@index([employeeId])
  @@index([effectiveFrom])
}

model SalaryStructureItem {
  id                String          @id @default(cuid())
  salaryStructureId String
  component         SalaryComponent
  amount            Float
  isPercentage      Boolean         @default(false)
  percentageOf      SalaryComponent?

  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
}

model BankDetail {
  id            String   @id @default(cuid())
  employeeId    String
  accountName   String
  accountNumber String
  ifscCode      String
  bankName      String
  branchName    String
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model SalarySlip {
  id          String   @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  grossPay    Float
  totalDeductions Float
  netPay      Float
  pdfUrl      String?
  generatedAt DateTime @default(now())
  paidAt      DateTime?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year, month])
}

// ─── LEAVES ──────────────────────────────────────────────────────────────────

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveType   LeaveType
  year        Int
  allocated   Float
  used        Float     @default(0)
  pending     Float     @default(0)
  carried     Float     @default(0)

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
}

model LeaveApplication {
  id           String      @id @default(cuid())
  employeeId   String
  leaveType    LeaveType
  fromDate     DateTime
  toDate       DateTime
  totalDays    Float
  reason       String
  status       LeaveStatus @default(PENDING)
  approverId   String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionNote String?
  documentUrl  String?
  lopDays      Float       @default(0)
  // Withdrawal trail. A PENDING leave cancels outright; an APPROVED one parks in
  // CANCELLATION_PENDING until the approver decides.
  cancelReason        String?
  cancelRequestedAt   DateTime?
  cancelledAt         DateTime?
  cancelApproverId    String?
  cancelRejectionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?   @relation("LeaveApprover", fields: [approverId], references: [id])
  cancelApprover Employee? @relation("LeaveCancelApprover", fields: [cancelApproverId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([fromDate, toDate])
  @@index([approverId])
}

// ─── PART-TIME TIMESHEET ──────────────────────────────────────────────────────

model PartTimeEntry {
  id            String   @id @default(cuid())
  employeeId    String
  date          DateTime
  lectureHours  Float    @default(0)
  ptmHours      Float    @default(0)
  otherHours    Float    @default(0)
  otherReason   String?
  answerScripts Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

// ─── REIMBURSEMENT CLAIMS ────────────────────────────────────────────────────

model ClaimTypeConfig {
  id               String   @id @default(cuid())
  name             String   @unique
  label            String
  requiresDocument Boolean  @default(false)
  isSettleable     Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ReimbursementClaim {
  id           String      @id @default(cuid())
  claimNumber  String      @unique
  employeeId   String
  claimType    String
  title        String
  description  String?
  claimedAmount Float
  approvedAmount Float?
  status       ClaimStatus @default(DRAFT)
  approverId   String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectionNote String?
  paidAt       DateTime?
  receipts     ClaimReceipt[]
  // Withdrawal trail — mirrors LeaveApplication. A SUBMITTED claim cancels outright;
  // an APPROVED one parks in CANCELLATION_PENDING until the approver decides.
  cancelReason        String?
  cancelRequestedAt   DateTime?
  cancelledAt         DateTime?
  cancelApproverId    String?
  cancelRejectionNote String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approver     Employee?   @relation("ClaimApprover", fields: [approverId], references: [id])
  cancelApprover Employee? @relation("ClaimCancelApprover", fields: [cancelApproverId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([claimType])
  @@index([approverId])
}

model ClaimReceipt {
  id        String             @id @default(cuid())
  claimId   String
  fileName  String
  fileUrl   String
  mimeType  String?
  amount    Float              @default(0)
  uploadedAt DateTime          @default(now())

  claim     ReimbursementClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

// ─── APP SETTINGS ────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── POLICY DOCUMENTS ────────────────────────────────────────────────────────

model PolicyDocument {
  id            String         @id @default(cuid())
  title         String
  category      PolicyCategory
  version       String
  description   String?
  fileUrl       String
  isActive      Boolean        @default(true)
  requiresAck   Boolean        @default(false)
  publishedAt   DateTime       @default(now())
  expiresAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@index([category])
  @@index([isActive])
}

model PolicyAcknowledgement {
  id          String         @id @default(cuid())
  employeeId  String
  policyId    String
  acknowledgedAt DateTime    @default(now())

  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  policy      PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([employeeId, policyId])
  @@index([employeeId])
  @@index([policyId])
}

// ─── TRAINING ────────────────────────────────────────────────────────────────

model TrainingProgram {
  id           String          @id @default(cuid())
  title        String
  description  String?
  provider     String?
  mode         String          @default("ONLINE")
  durationHours Float?
  startDate    DateTime?
  endDate      DateTime?
  seats        Int?
  isMandatory  Boolean         @default(false)
  certificateTemplateUrl String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  enrollments  TrainingEnrollment[]

  @@index([startDate])
  @@index([isMandatory])
}

model TrainingEnrollment {
  id            String          @id @default(cuid())
  employeeId    String
  programId     String
  status        TrainingStatus  @default(ENROLLED)
  enrolledAt    DateTime        @default(now())
  completedAt   DateTime?
  score         Float?
  certificateUrl String?
  feedback      String?

  employee      Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  program       TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([employeeId, programId])
  @@index([employeeId])
  @@index([programId])
  @@index([status])
}

// ─── EMPLOYEE DOCUMENTS ──────────────────────────────────────────────────────

model EmployeeDocument {
  id          String       @id @default(cuid())
  employeeId  String
  type        DocumentType
  label       String?
  fileName    String
  fileUrl     String
  fileSize    Int?
  mimeType    String?
  uploadedAt  DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([type])
}

// ─── ROLE PERMISSIONS ────────────────────────────────────────────────────────

model RolePermission {
  id          String   @id @default(cuid())
  role        String   // "SUPER_ADMIN" | "HR_ADMIN" | "DEPT_HEAD" | "EMPLOYEE"
  module      String   // "EMPLOYEES" | "LEAVES" | "CLAIMS" | "POLICIES" | "TRAINING" | "REPORTS" | "ADMIN"
  canView     Boolean  @default(false)
  canCreate   Boolean  @default(false)
  canEdit     Boolean  @default(false)
  canDelete   Boolean  @default(false)
  canApprove  Boolean  @default(false)
  canAppraise Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@unique([role, module])
  @@index([role])
}

// ─── HOLIDAYS ────────────────────────────────────────────────────────────────

model Holiday {
  id          String   @id @default(cuid())
  name        String
  fromDate    DateTime
  toDate      DateTime
  year        Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year])
  @@index([fromDate])
}

// ─── LEAVE POLICIES ──────────────────────────────────────────────────────────

model LeavePolicy {
  id          String            @id @default(cuid())
  name        String
  description String?
  isActive    Boolean           @default(true)
  carryForward Boolean          @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  rules       LeavePolicyRule[]
  grades      LeavePolicyGrade[]
}

model LeavePolicyRule {
  id              String      @id @default(cuid())
  policyId        String
  leaveType       LeaveType
  daysPerYear     Float
  maxCarryForward Float       @default(0)

  policy          LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, leaveType])
  @@index([policyId])
}

model LeavePolicyGrade {
  id       String      @id @default(cuid())
  policyId String
  grade    String

  policy   LeavePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, grade])
  @@index([policyId])
}

// ─── BONUS PLANS ─────────────────────────────────────────────────────────────

model BonusPlan {
  id            String             @id @default(cuid())
  employeeId    String
  appraiserId   String
  title         String
  totalAmount   Float
  frequency     BonusPlanFrequency
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        BonusPlanStatus    @default(ACTIVE)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  employee      Employee           @relation("BonusReceiver",  fields: [employeeId],  references: [id], onDelete: Cascade)
  appraiser     Employee           @relation("BonusAppraiser", fields: [appraiserId], references: [id])
  payouts       BonusPayout[]

  @@index([employeeId])
  @@index([appraiserId])
  @@index([status])
}

model BonusPayout {
  id            String            @id @default(cuid())
  planId        String
  employeeId    String
  amount        Float
  scheduledDate DateTime
  status        BonusPayoutStatus @default(SCHEDULED)
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  plan          BonusPlan         @relation(fields: [planId],     references: [id], onDelete: Cascade)
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([employeeId])
  @@index([scheduledDate])
  @@index([status])
}

// ─── TASKS ───────────────────────────────────────────────────────────────────

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  assignedById   String
  assignedToId   String
  assignedDate   DateTime     @default(now())
  dueDate        DateTime
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(OPEN)
  attachmentUrl  String?
  attachmentName String?

  assignedBy     Employee      @relation("TaskAssigner", fields: [assignedById], references: [id])
  assignedTo     Employee      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  comments       TaskComment[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([assignedToId])
  @@index([assignedById])
  @@index([dueDate])
  @@index([status])
}

model TaskComment {
  id        String       @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  parentId  String?

  task      Task         @relation(fields: [taskId],   references: [id], onDelete: Cascade)
  author    Employee     @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  parent    TaskComment? @relation("CommentReplies",   fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   TaskComment[] @relation("CommentReplies")

  createdAt DateTime     @default(now())

  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
}

// ─── AUDIT LOG ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  employeeId String?
  action     String
  entity     String
  entityId   String
  /// Human-readable one-liner ("Casual leave, 2 days, 5 Aug – 6 Aug") so the log
  /// stays readable even after the underlying row is gone.
  summary    String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor      Employee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([action])
}

// ─── USER SESSIONS ───────────────────────────────────────────────────────────

model Session {
  id           String   @id @default(cuid())
  employeeId   String
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([employeeId])
  @@index([expiresAt])
}

// ─── ANNOUNCEMENTS ──────────────────────────────────────────────────────────

model Announcement {
  id             String               @id @default(cuid())
  title          String
  body           String
  type           AnnouncementType     @default(GENERAL)
  status         AnnouncementStatus   @default(DRAFT)
  audience       AnnouncementAudience @default(ALL_EMPLOYEES)
  pinned         Boolean              @default(false)
  attachments    Json                 @default("[]")
  expiresAt      DateTime?
  publishedAt    DateTime?
  notifiedCount  Int                  @default(0)
  postedById     String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  postedBy       Employee             @relation("AnnouncementAuthor", fields: [postedById], references: [id])
  views          AnnouncementView[]
  acks           AnnouncementAck[]

  @@index([status])
  @@index([pinned])
  @@index([createdAt])
  @@index([expiresAt])
}

model AnnouncementView {
  id             String       @id @default(cuid())
  announcementId String
  employeeId     String
  viewedAt       DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee       Employee     @relation("AnnouncementViewer", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([announcementId])
  @@index([employeeId])
}

model AnnouncementAck {
  id             String       @id @default(cuid())
  announcementId String
  employeeId     String
  ackedAt        DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employee       Employee     @relation("AnnouncementAcker", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([announcementId, employeeId])
  @@index([announcementId])
  @@index([employeeId])
}

// ─── PERSONAL TODOS ─────────────────────────────────────────────────────────

model PersonalTodo {
  id              String        @id @default(cuid())
  employeeId      String
  title           String
  description     String?
  category        String        @default("General")
  dueDate         DateTime?
  priority        TodoPriority  @default(MEDIUM)
  completed       Boolean       @default(false)
  completedAt     DateTime?
  reminderType    ReminderType  @default(NONE)
  reminderAt      DateTime?
  googleEventId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([dueDate])
  @@index([completed])
}

model GoogleCalendarConnection {
  id            String   @id @default(cuid())
  employeeId    String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  calendarId    String   @default("primary")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─── TEAM MEMBERSHIP ────────────────────────────────────────────────────────

model TeamMembership {
  id          String   @id @default(cuid())
  teamOwnerId String
  memberId    String
  addedAt     DateTime @default(now())

  teamOwner   Employee @relation("TeamOwner", fields: [teamOwnerId], references: [id], onDelete: Cascade)
  member      Employee @relation("TeamMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamOwnerId, memberId])
  @@index([teamOwnerId])
  @@index([memberId])
}

// ─── SALARY CONFIG ──────────────────────────────────────────────────────────

model EmployeeSalaryConfig {
  id             String         @id @default(cuid())
  employeeId     String         @unique
  employmentType EmploymentType
  config         Json
  effectiveFrom  DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ─── STUDENTS ────────────────────────────────────────────────────────────────

model Student {
  id                 String        @id @default(cuid())
  studentCode        String        @unique
  email              String        @unique
  passwordHash       String
  mustChangePassword Boolean       @default(true)

  firstName          String
  lastName           String
  middleName         String?
  gender             Gender?
  dateOfBirth        DateTime?
  photoUrl           String?
  phone              String?
  address            Json?

  rollNumber         String?

  parentName         String?
  parentPhone        String?
  parentEmail        String?
  parentRelation     String?
  parentOccupation   String?
  parentAddress      Json?

  motherName         String?
  motherPhone        String?
  motherEmail        String?
  motherOccupation   String?

  communicationContact     String?   // FATHER | MOTHER | BOTH | OTHER
  communicationContactName  String?
  communicationContactPhone String?

  admissionNumber    String?       @unique
  admissionDate      DateTime?
  academicYear       String?
  schoolId           String?
  school             School?       @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  nationality        String?       @default("Indian")

  totalFee           Float?
  paidFee            Float?
  discountType       String?   // "PERCENTAGE" | "AMOUNT"
  discountAmount     Float?
  paymentDate        DateTime?
  paymentMode        String?
  receiptNumber      String?
  paymentNote        String?

  gradeId            String?
  grade              Grade?        @relation(fields: [gradeId], references: [id], onDelete: SetNull)

  courseId           String?
  course             Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  studentBatches     StudentBatch[]
  batchHistory       StudentBatchHistory[]

  initialPasswordHash String?

  instalments        StudentInstalment[]
  paymentLogs        StudentPaymentLog[]

  status             StudentStatus @default(ACTIVE)
  isArchived         Boolean       @default(false)

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  sessions            StudentSession[]
  submissions         AssignmentSubmission[]
  examResults         ExamResult[]
  scheduleAttendances ScheduleAttendance[]
  ptms                PTM[]
  feedbacks           StudentFeedback[]

  @@index([schoolId])
  @@index([status])
  @@index([email])
  @@index([studentCode])
}

model StudentSession {
  id           String   @id @default(cuid())
  studentId    String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
}

// ─── ACADEMIC FOUNDATION ─────────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches   Batch[]
  schedules Schedule[]
  centres   Centre[]

  @@index([isActive])
}

model Centre {
  id        String    @id @default(cuid())
  name      String    @unique
  cityId    String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  city      Location? @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([cityId])
  @@index([isActive])
}

model Batch {
  id               String    @id @default(cuid())
  name             String
  description      String?
  locationId       String?
  academicYear     String
  startDate        DateTime?
  schoolId         String?
  gradeId          String?
  facultyMentorId  String?
  schoolIds        String[]  @default([])
  courseIds        String[]  @default([])
  targetStrength   Int?
  isActive         Boolean   @default(true)
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  location        Location? @relation(fields: [locationId],    references: [id], onDelete: SetNull)
  school          School?   @relation(fields: [schoolId],      references: [id], onDelete: SetNull)
  grade           Grade?    @relation(fields: [gradeId],       references: [id], onDelete: SetNull)
  facultyMentor   Employee? @relation("BatchFacultyMentor",    fields: [facultyMentorId], references: [id], onDelete: SetNull)
  studentBatches  StudentBatch[]
  batchSubjects   BatchSubject[]
  batchHistories  StudentBatchHistory[]
  schedules       ScheduleBatch[]
  assignments     AssignmentBatch[]
  examBatches     ExamBatch[]

  @@index([academicYear])
  @@index([isActive])
  @@index([locationId])
  @@index([schoolId])
  @@index([gradeId])
}

model StudentBatchHistory {
  id           String    @id @default(cuid())
  studentId    String
  batchId      String?
  batchName    String
  academicYear String?
  assignedAt   DateTime
  removedAt    DateTime  @default(now())

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch        Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model StudentBatch {
  id        String   @id @default(cuid())
  studentId String
  batchId   String
  joinedAt  DateTime @default(now())

  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId])
  @@index([studentId])
  @@index([batchId])
}

model Subject {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batchSubjects BatchSubject[]
  schedules     Schedule[]
  assignments   Assignment[]
  examSubjects  ExamSubject[]

  @@index([isActive])
}

model BatchSubject {
  id         String    @id @default(cuid())
  batchId    String
  subjectId  String
  employeeId String?

  batch      Batch     @relation(fields: [batchId],    references: [id], onDelete: Cascade)
  subject    Subject   @relation(fields: [subjectId],  references: [id], onDelete: Cascade)
  employee   Employee? @relation("FacultySubjects",    fields: [employeeId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())

  @@unique([batchId, subjectId])
  @@index([batchId])
  @@index([subjectId])
  @@index([employeeId])
}

// ─── ACADEMIC SETTINGS ───────────────────────────────────────────────────────

model AcademicYear {
  id         String   @id @default(cuid())
  name       String   @unique
  isActive   Boolean  @default(true)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TargetExam {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  category  String   @default("BOARD")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model Grade {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  batches   Batch[]
}

model Course {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  duration    String?
  fee         Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students         Student[]
  instalmentPlans  InstalmentPlan[]

  @@index([isActive])
}

model InstalmentPlan {
  id          String               @id @default(cuid())
  name        String
  courseId    String?
  description String?
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  course      Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  items       InstalmentPlanItem[]

  @@index([courseId])
  @@index([isActive])
}

model InstalmentPlanItem {
  id                String         @id @default(cuid())
  planId            String
  instalmentNo      Int
  label             String?
  amount            Float
  daysFromAdmission Int?
  dueDate           DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  plan              InstalmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model StudentInstalment {
  id           String    @id @default(cuid())
  studentId    String
  instalmentNo Int
  label        String?
  amount       Float
  dueDate      DateTime?
  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  paidAmount   Float?
  paymentMode  String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentLogs  StudentPaymentLog[]

  @@index([studentId])
}

model StudentPaymentLog {
  id            String    @id @default(cuid())
  studentId     String
  instalmentId  String?
  amount        Float
  paymentMode   String?
  paymentDate   DateTime?
  receiptNumber String?
  note          String?
  createdAt     DateTime  @default(now())

  student       Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instalment    StudentInstalment? @relation(fields: [instalmentId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  city      String?
  board     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students  Student[]
  batches   Batch[]

  @@index([isActive])
}

// ─── DIRECTORY ───────────────────────────────────────────────────────────────

model DirectoryEntry {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  areas        String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([displayOrder])
}

// ─── SCHEDULE ────────────────────────────────────────────────────────────────

model Schedule {
  id           String         @id @default(cuid())
  academicYear String
  subjectId    String?
  employeeId   String?
  locationId   String?
  mode         ClassMode      @default(OFFLINE)
  date         DateTime       @db.Date
  startTime    DateTime
  endTime      DateTime
  topics       String?
  notes        String?
  status       ScheduleStatus @default(UPCOMING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subject      Subject?       @relation(fields: [subjectId],  references: [id], onDelete: SetNull)
  employee     Employee?      @relation("FacultySchedules", fields: [employeeId], references: [id], onDelete: SetNull)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  batches      ScheduleBatch[]
  attendances  ScheduleAttendance[]
  assignments  Assignment[]

  @@index([date])
  @@index([status])
  @@index([academicYear])
  @@index([employeeId])
  @@index([locationId])
}

model ScheduleAttendance {
  id         String   @id @default(cuid())
  scheduleId String
  studentId  String
  isPresent  Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId],  references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId])
  @@index([scheduleId])
  @@index([studentId])
}

model ScheduleBatch {
  id         String   @id @default(cuid())
  scheduleId String
  batchId    String

  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  batch      Batch    @relation(fields: [batchId],    references: [id], onDelete: Cascade)

  @@unique([scheduleId, batchId])
  @@index([scheduleId])
  @@index([batchId])
}

// ─── ASSIGNMENTS ──────────────────────────────────────────────────────────────

model Assignment {
  id             String           @id @default(cuid())
  academicYear   String
  name           String
  assignmentDate DateTime         @db.Date
  submissionDate DateTime         @db.Date
  subjectId      String?
  employeeId     String?
  scheduleId     String?
  topics         String?
  note           String?
  attachmentUrl  String?
  attachmentName String?
  status         AssignmentStatus @default(DUE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subject     Subject?               @relation(fields: [subjectId],  references: [id], onDelete: SetNull)
  employee    Employee?              @relation("FacultyAssignments", fields: [employeeId], references: [id], onDelete: SetNull)
  schedule    Schedule?              @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  batches     AssignmentBatch[]
  submissions AssignmentSubmission[]

  @@index([academicYear])
  @@index([status])
  @@index([submissionDate])
  @@index([subjectId])
  @@index([employeeId])
  @@index([scheduleId])
}

model AssignmentBatch {
  id           String     @id @default(cuid())
  assignmentId String
  batchId      String

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  batch      Batch      @relation(fields: [batchId],      references: [id], onDelete: Cascade)

  @@unique([assignmentId, batchId])
  @@index([assignmentId])
  @@index([batchId])
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String
  status         SubmissionStatus @default(NOT_SUBMITTED)
  submittedAt    DateTime?
  reviewNote     String?
  attachmentUrl  String?
  attachmentName String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId],    references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@index([status])
}

// ─── ASSESSMENTS ─────────────────────────────────────────────────────────────

model Exam {
  id           String     @id @default(cuid())
  academicYear String
  name         String
  numPapers    Int        @default(1)
  numSubjects  Int        @default(1)
  examDate     DateTime   @db.Date
  startTime    String
  endTime      String
  totalMarks   Int?
  status       ExamStatus @default(DUE)
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  batches  ExamBatch[]
  subjects ExamSubject[]
  results  ExamResult[]

  @@index([academicYear])
  @@index([status])
  @@index([examDate])
}

model ExamSubject {
  id          String  @id @default(cuid())
  examId      String
  paperNum    Int
  subjectSlot Int
  subjectId   String?
  topics      String?
  maxMarks    Float?

  exam    Exam     @relation(fields: [examId],    references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@unique([examId, paperNum, subjectSlot])
  @@index([examId])
  @@index([subjectId])
}

model ExamBatch {
  id      String @id @default(cuid())
  examId  String
  batchId String

  exam  Exam  @relation(fields: [examId],  references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([examId, batchId])
  @@index([examId])
  @@index([batchId])
}

model ExamResult {
  id         String   @id @default(cuid())
  examId     String
  studentId  String
  attended   Boolean  @default(true)
  isExcluded Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  exam    Exam    @relation(fields: [examId],    references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  marks   ExamMark[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
}

model ExamMark {
  id           String @id @default(cuid())
  examResultId String
  paperNum     Int
  subjectSlot  Int
  marks        Float?

  result ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)

  @@unique([examResultId, paperNum, subjectSlot])
  @@index([examResultId])
}

// ─── PTM (Parent–Teacher Meeting) ────────────────────────────────────────────

model PTM {
  id          String        @id @default(cuid())
  studentId   String
  date        DateTime      @db.Date
  startTime   String        // "HH:MM" 24-hr
  endTime     String?       // optional
  venue       String?
  agenda      String?
  status      PTMStatus     @default(SCHEDULED)
  notes       String?       // post-meeting general discussion notes
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  student     Student         @relation(fields: [studentId],   references: [id], onDelete: Cascade)
  createdBy   Employee?       @relation("PTMCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attendees   PTMAttendee[]
  actionItems PTMActionItem[]

  @@index([studentId])
  @@index([date])
}

model PTMAttendee {
  id         String   @id @default(cuid())
  ptmId      String
  employeeId String
  createdAt  DateTime @default(now())

  ptm      PTM      @relation(fields: [ptmId],      references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([ptmId, employeeId])
  @@index([ptmId])
}

model PTMActionItem {
  id          String          @id @default(cuid())
  ptmId       String
  description String
  status      PTMActionStatus @default(YET_TO_START)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  ptm PTM @relation(fields: [ptmId], references: [id], onDelete: Cascade)

  @@index([ptmId])
}

enum PTMStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PTMActionStatus {
  YET_TO_START
  ONGOING
  COMPLETED
}

// ─── STUDENT FEEDBACK ────────────────────────────────────────────────────────

enum FeedbackType {
  SUGGESTION
  CONCERN
}

enum FeedbackStatus {
  OPEN              // submitted, awaiting admin
  RESPONDED         // admin replied, awaiting student
  CLOSED            // closed by admin
  CLOSED_BY_STUDENT // student closed it ("Closed by sender" from admin POV)
}

model StudentFeedback {
  id           String         @id @default(cuid())
  studentId    String
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  type         FeedbackType
  message      String         @db.Text   // the original submission message
  status       FeedbackStatus @default(OPEN)

  retractedAt  DateTime?      // soft-delete: student permanently removed it
  adminNote    String?        // kept for migration compat (use messages instead)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  messages     FeedbackMessage[]

  @@index([studentId])
  @@index([status])
}

model FeedbackMessage {
  id             String          @id @default(cuid())
  feedbackId     String
  feedback       StudentFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  senderType     String          // "STUDENT" | "ADMIN"
  senderId       String          // studentId or employeeId
  senderName     String          // denormalized full name

  message        String          @db.Text
  attachmentUrl  String?
  attachmentName String?

  createdAt      DateTime        @default(now())

  @@index([feedbackId])
}
